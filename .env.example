APP_PORT=8080
APP_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=pos_koperasi
DB_SSLMODE=disable
# Pool Postgres — sesuaikan dengan jumlah replica × koneksi (dan PgBouncer jika ada)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# Timeout HTTP — baca "0" = tanpa batas untuk field tersebut (hati-hati di internet publik)
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=60s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=25s

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY_HOURS=24

# Midtrans
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pos_koperasi
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_CONN_IDLE_TIME=10m

# Redis: stream midtrans:webhooks + notifications:member. Tanpa ini, webhook & notifikasi bayar sinkron.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
